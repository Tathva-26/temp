# Public browser-visible configuration
# Do not put secrets in NEXT_PUBLIC_* variables.
# Auth options (pick one):
# A) Test via deployed ca-frontend proxy (same API/DB as CA). Deploy ca pages/api/auth + /api/user first.
# NEXT_PUBLIC_AUTH_PROXY_URL=https://ca.tathva.org
# NEXT_PUBLIC_OAUTH_ROLE=ca-none
# B) Local rewrite on this app (default when A is unset): /api/auth -> NEXT_PUBLIC_API
# C) Direct API like ca-frontend (needs CORS for this site on the API):
# NEXT_PUBLIC_AUTH_VIA_PROXY=false
# Use the deployed API. Do not point at localhost:5000 on macOS — that port is AirPlay.
NEXT_PUBLIC_API=https://api.tathva.org
NEXT_PUBLIC_BACKEND_ENABLED=true

# Backend-only reference configuration
# These are placeholders for the API service, not values to expose to Next.js.
# The backend mounts better-auth at /api/auth/* and owns the session cookie;
# the frontend never sees a token.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Google's redirect target is better-auth's own callback route.
GOOGLE_REDIRECT_URI=https://api.tathva.org/api/auth/callback/google
FRONTEND_URL=https://tathva.org
# better-auth: secret for signing the session cookie, and the origins allowed
# to carry it. TRUSTED_ORIGINS must include the frontend for CORS + cookies.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://api.tathva.org
TRUSTED_ORIGINS=https://tathva.org,http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/tathva
TIQR_API_BASE_URL=https://api.tiqr.events
TIQR_API_KEY=replace-if-required
PAYMENT_PROVIDER=replace-with-provider-name
PAYMENT_PROVIDER_KEY=replace-with-payment-key
PAYMENT_PROVIDER_SECRET=replace-with-payment-secret
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
PAYMENT_RETURN_URL=https://tathva.org/payment/success
PAYMENT_CANCEL_URL=https://tathva.org/payment/cancel
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
CONTACT_SUPPORT_EMAIL=replace-with-support-email
OBJECT_STORAGE_BUCKET=replace-with-bucket-name
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key