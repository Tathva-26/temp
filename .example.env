# Public browser-visible configuration. Do not put secrets in NEXT_PUBLIC_*.

# Origin of the backend. This origin must also be listed in the backend's
# ALLOWED_ORIGINS: that list fails closed, and a write from an unlisted origin
# comes back as 403 {"error":"Forbidden"} rather than a CORS error.
NEXT_PUBLIC_BACKEND_URL=https://api.tathva.org
# Legacy alias, still read as a fallback. Optional if BACKEND_URL is set.
NEXT_PUBLIC_API=https://api.tathva.org

# Set to "false" to render every backend-backed page as a "coming soon" notice.
NEXT_PUBLIC_BACKEND_ENABLED=true

# Host serving uploaded pictures — the backend's R2_PUBLIC_URL without the
# scheme. next/image rejects any host not declared in next.config.js.
NEXT_PUBLIC_IMAGE_HOST=cdn.tathva.org

# Role to request on first Google sign-in. The backend reads it in an
# after-hook and only applies it when the user row is created; an existing
# USER cannot become a CA this way. The CA site sets this to CA; leave it
# unset here so visitors sign up as ordinary users.
# NEXT_PUBLIC_OAUTH_ROLE=

# --- Backend reference only -------------------------------------------------
# Placeholders for the API service. Not read by Next.js; they live here so a
# local stack can be brought up from one file.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api.tathva.org/api/auth/callback/google
FRONTEND_URL=https://tathva.org
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://api.tathva.org
ALLOWED_ORIGINS=https://tathva.org,https://www.tathva.org,http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/tathva
