# Public browser-visible configuration (same pattern as ca-frontend)
# Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_BACKEND_URL=https://api.tathva.org
# Legacy alias — optional if BACKEND_URL is set
NEXT_PUBLIC_API=https://api.tathva.org
NEXT_PUBLIC_BACKEND_ENABLED=true
# Optional OAuth role passed in sign-in state (ca-frontend uses role: CA)
# NEXT_PUBLIC_OAUTH_ROLE=

# Backend-only reference configuration
# These are placeholders for the API service, not values to expose to Next.js.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api.tathva.org/api/auth/callback/google
FRONTEND_URL=https://tathva.org
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://api.tathva.org
TRUSTED_ORIGINS=https://tathva.org,https://www.tathva.org,http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/tathva
